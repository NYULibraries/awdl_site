---
import DefaultLayout from '../../layouts/DefaultLayout.astro';
import Content from '../../components/Content';
import SearchSubheader from '../../components/Search/Labels/SearchSubheader';
import SearchPagination from '../../components/Search/Tools/SearchPagination';
import { fetchSeriesData, fetchSolrDataBySeriesIdentifier } from '../../Util/fetch.ts';
import { contentStore } from '../../stores/contentStore';
import SearchHeader from '../../components/Search/Labels/SearchHeader';
import StoreInitializer from '../../components/Util/StoreInitializer';

const { seriesPID } = Astro.params;
if (!seriesPID) throw new Error('Series PID not found');

export const prerender = false;

// Fetch series and match seriesPID to path_alias
const seriesData = await fetchSeriesData();
const seriesDoc = seriesData?.response?.docs?.find((doc: any) => doc.path_alias === seriesPID);

if (!seriesDoc) {
	throw new Error(`Series not found: ${seriesPID}`);
}

// Get ss_series_identifier from the matching series
const seriesIdentifier = seriesDoc.ss_series_identifier;

if (!seriesIdentifier) {
	throw new Error(`Series identifier not found for: ${seriesPID}`);
}

// Fetch all books containing the series identifier
const data = await fetchSolrDataBySeriesIdentifier({
	start: 0,
	rows: 12,
	seriesIdentifier: seriesIdentifier
});

// Initialize the content store after fetching data
contentStore.set(data);

// Use the series label from the found series document
const seriesLabel = seriesDoc.ss_series_label || seriesPID;
---

<DefaultLayout title={seriesLabel || 'Series'} bodyID="series">
	<main class="main container-fluid" role="main" id="mainContent" tabindex="-1">
		<StoreInitializer initialData={data} initialSearchField={seriesLabel} client:only="react">
			<SearchHeader seriesLabel={seriesLabel} client:only="react" />
			<div class="items-widget">
				<div class="top">
					<SearchSubheader
						initialData={{
							response: {
								numFound: data?.response.numFound,
								start: data?.response.start,
								docs: data?.response.docs
							}
						}}
						seriesIdentifier={seriesIdentifier}
						client:only="react"
					/>
				</div>
				<div
					id="items"
					class="widget items"
					data-name="items"
					data-rows="12"
					data-source="https://discovery1.dlib.nyu.edu/solr/viewer/select"
					data-fl="*"
					data-fq-bundle="dlts_book"
					data-fq-sm_collection_code="awdl"
					data-numfound={data?.response.numFound}
					data-start="0"
					data-docslength={data?.response.docs.length}
					data-requesterror="0"
				>
					<Content client:only="react" />
				</div>
				<div class="bottom text-center">
					<SearchPagination rows={12} seriesIdentifier={seriesIdentifier} client:only="react" />
				</div>
			</div>
		</StoreInitializer>
	</main>
</DefaultLayout>
