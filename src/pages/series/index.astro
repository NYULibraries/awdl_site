---
import DefaultLayout from '../../layouts/DefaultLayout.astro';
import SeriesContent from '../../components/Series/SeriesContent';
import { fetchSeriesData } from '../../Util/fetch';

const data = await fetchSeriesData();
---

<DefaultLayout title="Series" bodyID="series" bodyClass="page">
	<main class="main container-fluid" role="main" id="mainContent" tabindex="-1">
		<header>
			<h1 class="page-title">Series</h1>
		</header>
		<SeriesContent data={data} client:only="react" />
	</main>
</DefaultLayout>
