---
import { Image } from 'astro:assets';
import DefaultLayout from '../../layouts/DefaultLayout.astro';
import ISAWLibrary from '../../../src/assets/images/ISAWLibrary420.jpg';
import CollectionItem from '../../components/Collections/CollectionItem';

const baseURL: string = import.meta.env.BASE_URL;
---

<DefaultLayout bodyID="collections-overview">
  <div class="container-fluid">
    <div class="flex-container">
      <main class="main hasSidebar" role="main" id="mainContent" tabindex="-1">
        <h2 class="page-title">Collections Overview</h2>
        <div class="maintext">
          <p>
            AWDL's purpose is to present the broadest possible range of
            scholarly materials relevant to the study of the ancient world.
          </p>
          <p>Particular strengths of the AWDL collection include:</p>
          <div class="flex-container">
            <CollectionItem/>
            <div class="item">
              <div class="card">
                <a href={`${baseURL}search/?q=%22ancient%20judaism%22`}
                  >Ancient Judaism</a
                >
              </div>
            </div>
            <div class="item">
              <div class="card">
                <a href={`${baseURL}search/?q=%22ancient%20science%22`}
                  >Ancient Science</a
                >
              </div>
            </div>
            <div class="item">
              <div class="card">
                <a href={`${baseURL}search/?q=assyriology`}>Assyriology</a>
              </div>
            </div>
            <div class="item">
              <div class="card">
                <a href={`${baseURL}search/?q=%22central%20asia%22`}
                  >Central Asia</a
                >
              </div>
            </div>
            <div class="item">
              <div class="card">
                <a href={`${baseURL}search/?q=%22Classical%20Antiquity%22`}
                  >Classical Antiquity</a
                >
              </div>
            </div>
            <div class="item">
              <div class="card">
                <a href={`${baseURL}search/?q=%22Early%20Christianity%22`}
                  >Early Christianity</a
                >
              </div>
            </div>
            <div class="item">
              <div class="card">
                <a href={`${baseURL}search/?q=egyptology`}>Egyptology</a>
              </div>
            </div>
            <div class="item">
              <div class="card">
                <a href={`${baseURL}search/?q=hittitology`}>Hittitology</a>
              </div>
            </div>
            <div class="item">
              <div class="card">
                <a href={`${baseURL}search/?q=%22iranian%20studies%22`}
                  >Iranian studies</a
                >
              </div>
            </div>
            <div class="item">
              <div class="card">
                <a href={`${baseURL}search/?q=papyrology`}>Papyrology</a>
              </div>
            </div>
          </div>
        </div>
      </main>
      <aside role="complementary">
        <h3 class="sidebar-title">AWDL Atlas</h3>
        <div class="content">
          <div class="imgHold">
            <Image
              src={ISAWLibrary}
              alt="Book Stacks at the Institute for the Study of the Ancient World"
            />
          </div>
        </div>
      </aside>
    </div>
  </div></DefaultLayout
>
