---
import '../assets/sass/style.scss';
import Header from '../components/Header/Header.astro';
import Meta from '../components/Header/Meta.astro';
import { metatags } from "../components/Header/metatags";

interface Props {
	title: string;
	description?: string;
	author?: string;
}

const {
	title,
	description = metatags.poweredDesc,
	author = metatags.defaultAuthor,
}: Props = Astro.props;
---

<html lang="en">
	<head>
		<Meta title={title} description={description} author={author} />
	</head>
	<body id="book">
		<div id="skipnav"><a href="#mainContent">Skip navigation</a></div>
		<Header />
		<slot />
		<!-- <script>
      import('../scripts/webfontloader.ts');
    </script> -->
	</body>
</html>
