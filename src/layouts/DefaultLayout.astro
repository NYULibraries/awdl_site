---
import '../assets/sass/style.scss';
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import Meta from '../components/Header/Meta.astro';
// import { metatags } from "../utils/Constants/metatags";

interface Props {
  bodyID?: string;
  bodyClass?: string;
}

const title: string = 'title';
const description: string = 'desc';
const { bodyID = '', bodyClass = '' }: Props = Astro.props;
---

<html lang="en">
  <head>
    <Meta title={title} description={description} />
  </head>
  <body id={bodyID} class={bodyClass}>
    <div id="skipnav"><a href="#mainContent">Skip navigation</a></div>
    <Header />
      <slot />
    <Footer />
    <!-- <script>
      import('../scripts/webfontloader.ts');
    </script> -->
  </body>
</html>
