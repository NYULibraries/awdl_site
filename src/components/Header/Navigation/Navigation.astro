---
import SearchForm from '../../Search/Tools/SearchForm';
import NavigationMobile from './NavigationMobile.astro';

const baseURL: string = import.meta.env.BASE_URL;
const NavigationItems = [
	{
		href: `/`,
		class: 'home',
		label: 'Home'
	},
	{
		href: `/collectionsoverview`,
		class: 'collectionsoverview',
		label: 'Collections Overview'
	},
	{
		href: `/series`,
		class: 'series',
		label: 'Series'
	},
	{
		href: `/about`,
		class: 'about',
		label: 'About'
	},
	{
		href: `/partners`,
		class: 'partners',
		label: 'Partners'
	},
	{
		href: `/browse`,
		class: 'browse',
		label: 'Browse'
	}
];
---

<nav class="navbar navbar-default" role="navigation">
	<div class="container-fluid">
		<div class="navbar-header">
			<NavigationMobile />
		</div>

		<div class="navbar-collapse">
			<ul class="nav navbar-nav">
				{
					NavigationItems.map((item) => {
						return (
							<li>
								<a href={item.href} class={item.class}>
									{item.label}
								</a>
							</li>
						);
					})
				}
			</ul>
			<div class="search_holder widget navbar-form navbar-right">
				<SearchForm client:only="react" />
			</div>
		</div>
	</div>
</nav>
