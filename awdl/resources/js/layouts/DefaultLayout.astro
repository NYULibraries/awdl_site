---
import '../assets/sass/style.scss';
import Header from '../components/Header/Header.astro';
import Footer from '../components/Footer/Footer.astro';
import Meta from '../components/Header/Meta.astro';
import { metatags } from '../components/Header/metatags';

interface Props {
	title: string;
	description?: string;
	author?: string;
	bodyID?: string;
	bodyClass?: string;
}

const {
	title,
	description = metatags.poweredDesc,
	author = metatags.defaultAuthor,
	bodyID = '',
	bodyClass = ''
}: Props = Astro.props;
---

<html lang="en">
	<head>
		<Meta title={title} description={description} author={author} />
	</head>
	<body id={bodyID} class={bodyClass}>
		<div id="skipnav"><a href="#mainContent">Skip navigation</a></div>
		<Header />
		<slot />
		<Footer />
		<script>
			import WebFont from 'webfontloader';

			WebFont.load({
				google: {
					families: ['Open Sans:300,400,600']
				},
				active: function () {
					document.documentElement.classList.add('wf-active');
				}
			});
		</script>
	</body>
</html>
