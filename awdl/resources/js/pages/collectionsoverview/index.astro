---
import { Image } from 'astro:assets';
import DefaultLayout from '../../layouts/DefaultLayout.astro';
import ISAWLibrary from '../../../src/assets/images/ISAWLibrary420.jpg';
import CollectionItem from '../../components/Collections/CollectionItem';

const baseURL: string = '';
const collectionItems = [
	{ label: 'Ancient Judaism' },
	{ label: 'Ancient Science' },
	{ label: 'Assyriology' },
	{ label: 'Central Asia' },
	// This url is originally title cased
	{ label: 'Classical Antiquity' },
	// This url is originally title cased
	{ label: 'Early Christianity' },
	{ label: 'Egyptology' },
	{ label: 'Hittitology' },
	{ label: 'Iranian studies' },
	{ label: 'Papyrology' }
];
---

<DefaultLayout title="Collections Overview" bodyID="collections-overview">
	<div class="container-fluid">
		<div class="flex-container">
			<main class="main hasSidebar" role="main" id="mainContent" tabindex="-1">
				<h2 class="page-title">Collections Overview</h2>
				<div class="maintext">
					<p>
						AWDL's purpose is to present the broadest possible range of scholarly materials relevant to the study of the
						ancient world.
					</p>
					<p>Particular strengths of the AWDL collection include:</p>
					<div class="flex-container">
						{
							collectionItems.map((item) => {
								return <CollectionItem label={item.label} />;
							})
						}
					</div>
				</div>
			</main>
			<aside role="complementary">
				<h3 class="sidebar-title">AWDL Atlas</h3>
				<div class="content">
					<div class="imgHold">
						<Image src={ISAWLibrary} alt="Book Stacks at the Institute for the Study of the Ancient World" />
					</div>
				</div>
			</aside>
		</div>
	</div></DefaultLayout
>
