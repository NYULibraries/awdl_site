{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:ssr": "vite build && vite build --ssr",
    "dev": "vite",
    "format": "prettier --write resources/",
    "format:check": "prettier --check resources/",
    "lint": "eslint . --fix",
    "types": "tsc --noEmit",
    "e2etest": "npx playwright test",
    "e2etest:ui": "npx playwright test --ui",
    "e2etest:rerun": "npx playwright test --last-failed",
    "e2etest:debug": "npx playwright test --debug",
    "e2etest:report": "npx playwright show-report"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.4",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.56.1",
    "@stylistic/eslint-plugin": "^1.8.1",
    "@stylistic/eslint-plugin-js": "^1.8.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.8.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "axios": "^1.15.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^15.14.0",
    "laravel-vite-plugin": "^2.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^7.0.7",
    "vite-plugin-markdown": "^2.2.0"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@inertiajs/react": "^2.2.8",
    "@vitejs/plugin-react": "^5.0.4",
    "antd": "^5.27.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "sass": "^1.93.2"
  }
}
