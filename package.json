{
	"name": "awdl",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check-version": "npm run preinstall && npm run check-versions && npm install",
		"lint": "npx eslint .",
		"fixlint": "npx eslint . --fix",
		"format": "prettier --check 'src/**/**.{js,jsx,css,astro}'",
		"fixformat": "prettier --write 'src/**/**.{js,jsx,css,astro}'",
		"e2etest": "npx playwright test",
		"e2etest:ui": "npx playwright test --ui",
		"e2etest:rerun": "npx playwright test --last-failed",
		"e2etest:debug": "npx playwright test --debug",
		"e2etest:report": "npx playwright show-report"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.4",
		"@astrojs/react": "^3.0.10",
		"@astrojs/sitemap": "^3.4.0",
		"@nanostores/react": "^1.0.0",
		"@tanstack/react-query": "^5.59.14",
		"@types/react-dom": "^18.3.0",
		"@types/webfontloader": "^1.6.38",
		"antd": "^5.25.4",
		"astro": "^4.4.5",
		"astro-aws-amplify": "^0.2.4",
		"dotenv": "^16.4.7",
		"nanostores": "^1.0.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"rehype-external-links": "^3.0.0",
		"sass": "^1.49.9",
		"speakingurl": "^14.0.1",
		"webfontloader": "^1.6.28",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@playwright/test": "^1.55.0",
		"@stylistic/eslint-plugin": "^1.6.2",
		"@stylistic/eslint-plugin-js": "^1.6.2",
		"@types/node": "^24.3.1",
		"@types/react": "^18.3.11",
		"@typescript-eslint/eslint-plugin": "^5.62.0",
		"@typescript-eslint/parser": "^5.62.0",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-astro": "^0.23.0",
		"eslint-plugin-import": "^2.29.1",
		"eslint-plugin-jsx-a11y": "^6.7.1",
		"eslint-plugin-prettier": "^5.1.3",
		"eslint-plugin-react": "^7.37.5",
		"prettier": "^3.2.5",
		"prettier-plugin-astro": "^0.14.1",
		"typescript": "^5.8.3"
	}
}
